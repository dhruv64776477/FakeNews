dist/
dist-ssr/
build/
out/
.vite/

# ───────────────────────────────────────────────────
# Environment & secrets  ← NEVER commit these!
# ───────────────────────────────────────────────────
.env
.env.*
!.env.example
server/.env

# ───────────────────────────────────────────────────
# Python / ML service
# ───────────────────────────────────────────────────
ml-service/venv/
ml-service/__pycache__/
ml-service/*.pyc
ml-service/*.pyo
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.Python

# HuggingFace / sentence-transformers model cache
# (stored in system cache, not in the repo)
*.bin
*.safetensors
*.ot

